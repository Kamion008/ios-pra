+/* Write `blocks` 512-byte ring blocks starting at ring block `start`, then
+ * the header sector. pra_emmc_lock must be HELD: this is the core the panic
+ * flush ran inline, refactored out so strat can call it from the CMD18
+ * chunk-failure path (strat already holds the lock) and the panic path can
+ * call it after acquiring-or-stealing the lock. Stop on the first failed
+ * sector: on a wedged card the next write_raw fails EBUSY after its bounded
+ * ready-poll (~1-2 s) and the caller reports the attempt - which is itself
+ * one line of forensics - instead of spinning 8192 times. */
+static int
+pra_log_flush_locked(uint64_t start, uint64_t blocks, uint64_t total,
+    uint32_t seq)
+{
+	uint8_t sector[512];
+	int error = 0;
+
+	if (start >= PRA_LOG_SIZE / 512u) {
+		return EINVAL;
+	}
+	if (start + blocks > PRA_LOG_SIZE / 512u) {
+		blocks = PRA_LOG_SIZE / 512u - start;
+	}
+	for (uint64_t block = start; block < start + blocks && !error;
+	    block++) {
+		memcpy(sector, pra_log_ring + (size_t)block * 512u,
+		    sizeof(sector));
+		error = pra_emmc_write_raw((uint32_t)(pra_log_erecovery_lba + 1u +
+		    block), sector);
+	}
+	if (!error) {
+		struct pra_log_header h = {
+			.magic = { 'P', 'R', 'A', 'L', 'O', 'G', '1', '\0' },
+			.version = 1,
+			.size = PRA_LOG_SIZE,
+			.total = total,
+			.seq = seq,
+		};
+		memset(sector, 0, sizeof(sector));
+		memcpy(sector, &h, sizeof(h));
+		error = pra_emmc_write_raw((uint32_t)pra_log_erecovery_lba, sector);
+	}
+	return error;
