+/*
+ * 0198: report the boot-argument arm result after the pralog ring is alive.
+ * 0 err + armed=1 is the healthy arm; err 2/3/4 names which step failed.
+ */
+void
+SweetHIDButtons::armReport(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = (SweetHIDButtons *)owner;
+
+	IOLog("SWEET HID: powerkey arm secs=%u err=%u armed=%d clients=%u\n",
+	    self->fKeySecs, self->fKeyErr, self->fKey != NULL ? 1 : 0,
+	    self->_clients ? self->_clients->getCount() : 0);
+}
+
+/*
+ * 0198: press once per firing, release 100 ms later, then repeat with
+ * volume-up after 120 s so the two consumer usages have visible controls.
+ */
+void
+SweetHIDButtons::keyFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = (SweetHIDButtons *)owner;
+	UInt32 usage;
+
+	if (self->fKeyStep == 0) {
+		self->fKeyRuns++;
+		self->fKeyStep = 1;
+		usage = self->fKeyRuns == 1 ? kHIDUsage_Csmr_Power :
+		    kHIDUsage_Csmr_VolumeIncrement;
+		IOLog("SWEET HID: powerkey %u down (interval %u s) usage 0x%x\n",
+		    self->fKeyRuns, self->fKeySecs, usage);
+		self->key(usage, true);
+		sender->setTimeoutMS(SWEET_KEY_HOLD_MS);
+		return;
+	}
+	usage = self->fKeyRuns == 1 ? kHIDUsage_Csmr_Power :
+	    kHIDUsage_Csmr_VolumeIncrement;
+	self->fKeyStep = 0;
+	self->key(usage, false);
+	IOLog("SWEET HID: powerkey %u up\n", self->fKeyRuns);
+	if (self->fKeyRuns >= SWEET_KEY_PAIRS) {
+		IOLog("SWEET HID: powerkey done\n");
+		return;
+	}
+	sender->setTimeoutMS(SWEET_KEY_GAP_S * 1000);
+}
