+static void
+pra_i2c_diag(const char *what, int error)
+{
+	uint32_t abrt = pra_i2c_last_abrt;
+	uint32_t ver = pra_touch_rd32(pra_i2c_regs, DW_IC_COMP_VERSION);
+	uint32_t type = pra_touch_rd32(pra_i2c_regs, DW_IC_COMP_TYPE);
+
+	printf("PRA i2c: %s err=%d abrt=%08x tar=%08x/%02x con=%08x "
+	    "en=%02x enstat=%02x stat=%02x flush=%u ver=%08x type=%08x",
