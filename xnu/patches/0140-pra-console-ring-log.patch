+/* Filesystem writes stay inside the selected root partition. */
+static int
+pra_emmc_write_sector(uint32_t lba, const uint8_t *sector)
+{
+	if (!pra_emmc_writable || lba < pra_emmc_first_lba ||
+	    (uint64_t)lba - pra_emmc_first_lba >= pra_emmc_nsectors) {
+		return EROFS;
+	}
+	return pra_emmc_write_raw(lba, sector);
+}
+
+/* Only the first PRA_LOG_SECTORS of erecovery_kernel are ever written. The
+ * lock is per sector: a 4 MiB flush must not stall filesystem I/O. */
+static int
+pra_log_write_sector(uint32_t lba, const uint8_t *sector)
+{
+	int error;
+	if (!pra_log_erecovery_sectors ||
+	    lba < pra_log_erecovery_lba ||
+	    (uint64_t)lba - pra_log_erecovery_lba >= PRA_LOG_SECTORS) {
+		return EROFS;
+	}
+	lck_mtx_lock(&pra_emmc_lock);
+	error = pra_emmc_write_raw(lba, sector);
+	lck_mtx_unlock(&pra_emmc_lock);
+	return error;
+}
+
+/* _cnputc may execute in any context. Keep this path free of locks and I/O. */
+void pra_log_append(const char *c, int size);
+void
+pra_log_append(const char *c, int size)
+{
+	if (!pra_log_enabled || size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&pra_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		pra_log_ring[(at + (uint64_t)i) % PRA_LOG_SIZE] = c[i];
+	}
+}
+
+static void
+pra_log_halt(void)
+{
+	printf("PRA LOG: halted; power off and reflash to continue\n");
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+static void
+pra_log_print(const char *buf, uint32_t len, uint64_t total, uint32_t seq)
+{
+	if (len == 0) {
+		printf("PRA LOG: empty\n");
+		return;
+	}
+	printf("\n==== PRA LOG seq=%u total=%llu last=%u ====\n",
+	    seq, total, len);
+	printf("%s", buf);
+	printf("\n==== PRA LOG end ====\n");
+}
+
+/* Read the tail of the log left behind by the previous boot. */
+static void
+pra_log_disk_tail(void)
+{
+	struct pra_log_header h;
+	uint8_t sector[512];
+	uint32_t out = 0;
+	uint64_t avail, len, start, block;
+	uint32_t skip;
+
+	if (pra_emmc_read_sector((uint32_t)pra_log_erecovery_lba, sector)) {
+		printf("PRA LOG: header read failed\n");
+		return;
+	}
+	memcpy(&h, sector, sizeof(h));
+	if (memcmp(h.magic, PRA_LOG_MAGIC, 7) || h.version != 1 ||
+	    h.size != PRA_LOG_SIZE) {
+		printf("PRA LOG: no previous log\n");
+		return;
+	}
+	avail = MIN(h.total, (uint64_t)PRA_LOG_SIZE);
+	len = MIN(avail, (uint64_t)PRA_LOG_TAIL);
+	start = h.total - len;
+	block = (start % PRA_LOG_SIZE) / 512u;
+	skip = (uint32_t)(start & 511u);
+	while (out < len) {
+		uint32_t take;
+		if (pra_emmc_read_sector(
+		    (uint32_t)(pra_log_erecovery_lba + 1u + block), sector)) {
+			printf("PRA LOG: read failed at block %llu\n", block);
+			break;
+		}
+		take = MIN(512u - skip, len - out);
+		memcpy(pra_log_buf + out, sector + skip, take);
+		out += take;
+		skip = 0;
+		block = (block + 1) % (PRA_LOG_SIZE / 512u);
+	}
+	pra_log_buf[out] = '\0';
+	pra_log_print(pra_log_buf, out, h.total, (uint32_t)h.seq);
+}
+
+/* Print the tail of the ring this boot has been filling. */
+static void
+pra_log_memory_tail(void)
+{
+	uint64_t total = os_atomic_load(&pra_log_total, relaxed);
+	uint64_t len = MIN(total, (uint64_t)PRA_LOG_TAIL);
+	uint64_t start = total - len;
+	for (uint64_t i = 0; i < len; i++) {
+		pra_log_buf[i] = pra_log_ring[(start + i) % PRA_LOG_SIZE];
+	}
+	pra_log_buf[len] = '\0';
+	pra_log_print(pra_log_buf, (uint32_t)len, total, 0);
+}
+
+static void
+pra_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t flushed = 0, seq = 0, last_total = 0;
+	int idle = 0, ticks = 0, write_fails = 0;
+	uint8_t sector[512];
+
+	for (;;) {
+		(void)tsleep(&pra_log_chan, PZERO, "pralog", hz * 10);
+		ticks++;
+		uint64_t total = os_atomic_load(&pra_log_total, relaxed);
+		if (total != flushed) {
+			/* A full ring means only the newest PRA_LOG_SIZE bytes
+			 * still matter; skip whatever was overwritten. */
+			uint64_t pos = total - flushed >= PRA_LOG_SIZE ?
+			    total - PRA_LOG_SIZE : flushed;
+			int error = 0;
+			while (pos < total && !error) {
+				uint32_t block =
+				    (uint32_t)((pos % PRA_LOG_SIZE) / 512u);
+				uint64_t lba = pra_log_erecovery_lba + 1u + block;
+				if (lba >= pra_log_erecovery_lba +
+				    PRA_LOG_SECTORS || lba > UINT32_MAX) {
+					error = EINVAL;
+					break;
+				}
+				memcpy(sector,
+				    pra_log_ring + (size_t)block * 512u,
+				    sizeof(sector));
+				error = pra_log_write_sector((uint32_t)lba,
+				    sector);
+				pos += 512u - (pos & 511u);
+			}
+			if (!error) {
+				struct pra_log_header h = {
+					.magic = { 'P', 'R', 'A', 'L', 'O', 'G',
+						   '1', '\0' },
+					.version = 1,
+					.size = PRA_LOG_SIZE,
+					.total = total,
+					.seq = ++seq,
+				};
+				memset(sector, 0, sizeof(sector));
+				memcpy(sector, &h, sizeof(h));
+				error = pra_log_write_sector(
+				    (uint32_t)pra_log_erecovery_lba, sector);
+			}
+			if (error) {
+				/* The root is mounted writable, so a filesystem write
+				 * may own the SDHCI channel while this flush runs: EBUSY
+				 * is expected and transient. Keep flushed where it is so
+				 * the next tick rewrites the same blocks, and bound how
+				 * many complaints reach the console: a stuck flusher must
+				 * never end the log loop, or the idle and at-limit dumps,
+				 * which are what makes a hang readable at all. */
+				if (++write_fails <= 8 || write_fails % 64 == 0) {
+					printf("PRA LOG: write failed %d after %d ticks\n",
+					    error, write_fails);
+				}
+			} else {
+				write_fails = 0;
+				flushed = total;
+			}
+		}
+		if (pra_log_idle_limit > 0) {
+			if (total == last_total) {
+				if (++idle >= pra_log_idle_limit) {
+					pra_log_memory_tail();
+					pra_log_halt();
+				}
+			} else {
+				idle = 0;
+				last_total = total;
+			}
+		}
+		if (pra_log_at_limit > 0 && ticks >= pra_log_at_limit) {
+			pra_log_memory_tail();
+			pra_log_halt();
+		}
+	}
+}
+
+static void
+pra_log_start(void)
+{
+	int enabled = 0, halt = 0, idle = 0, at = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("pralog", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("praloghalt", &halt, sizeof(halt));
+	(void)PE_parse_boot_argn("pralogidle", &idle, sizeof(idle));
+	(void)PE_parse_boot_argn("pralogat", &at, sizeof(at));
+	if (enabled != 1 && halt != 1) {
+		return;
+	}
+	if (pra_log_enabled || !pra_log_erecovery_sectors ||
+	    pra_log_erecovery_sectors < PRA_LOG_SECTORS ||
+	    pra_log_erecovery_lba + PRA_LOG_SECTORS - 1 > UINT32_MAX) {
+		return;
+	}
+	pra_log_idle_limit = idle > 0 ? (idle + 9) / 10 : 0;
+	pra_log_at_limit = at > 0 ? (at + 9) / 10 : 0;
+	pra_log_enabled = true;
+	printf("PRA LOG: erecovery_kernel first=%llu, %u sectors, idle=%d at=%d\n",
+	    pra_log_erecovery_lba, PRA_LOG_SECTORS, pra_log_idle_limit * 10,
+	    pra_log_at_limit * 10);
+	if (kernel_thread_start(pra_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		pra_log_enabled = false;
+	}
+}
+
+/* Print the previous boot's tail and stop before anything else can scroll
+ * it away. Called once the GPT lookup has found erecovery_kernel. */
+static void
+pra_log_probe(void)
+{
+	int halt = 0;
+	if (pra_log_probed) {
+		return;
+	}
+	pra_log_probed = true;
+	(void)PE_parse_boot_argn("praloghalt", &halt, sizeof(halt));
+	if (halt != 1) {
+		return;
+	}
+	if (!pra_log_erecovery_sectors) {
+		printf("PRA LOG: erecovery_kernel not found\n");
+		pra_log_halt();
+	}
+	pra_log_disk_tail();
+	pra_log_halt();
+}
