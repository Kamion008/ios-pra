+#if defined(ARM64_BOARD_CONFIG_PRA)
+/*
+ * Boot-arg pralog=1 keeps console text in a RAM ring in
+ * bsd/dev/pra_sdhci.c and flushes it to the erecovery_kernel partition.
+ * Hook the single character path rather than _cnputs: _cnputs ends up
+ * here once per character so nothing is counted twice, but only this
+ * hook sees the callers that go straight to one character, and it runs
+ * after the newline expansion below has queued its carriage return,
+ * so the persistent log is the sequence the screen really showed.
+ */
+extern void pra_log_append(const char *c, int size); /* bsd/dev/pra_sdhci.c */
+#endif
