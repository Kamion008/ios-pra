diff --git a/bsd/dev/pra_sdhci.c b/bsd/dev/pra_sdhci.c
--- a/bsd/dev/pra_sdhci.c
+++ b/bsd/dev/pra_sdhci.c
@@ -11,6 +11,19 @@
  * Root reads need no boot argument beyond rd=sdhcroot0; the selected GPT
  * partition defaults to "userdata" and can be changed with emmcroot=<name>.
  * Writes stay disabled unless emmcwrite=1 and the partition is "userdata".
+ *
+ * The UART is gated by EL3 and the framebuffer console wraps around, so the
+ * last lines of a hung boot are lost. Boot-arg pralog=1 keeps console output
+ * in a 4 MiB ring and flushes it every 10 s to the unused erecovery_kernel
+ * partition (p27, LBA 753664). praloghalt=1 prints the previous boot's tail
+ * at probe and halts, pralogat=<seconds> prints the in-memory tail and halts
+ * that long after the log starts, and pralogidle=<seconds> does the same
+ * after that much console silence, so a hang stays on the screen.
+ *
+ * Once the root is mounted writable the filesystem driver and this log
+ * driver share one SDHCI channel, so a flush can find the card busy. That
+ * is transient, so the flusher retries on the next tick instead of stopping,
+ * and only a bounded number of complaints reach the console.
  */
 #if defined(ARM64_BOARD_CONFIG_PRA)
 #include <sys/param.h>
@@ -67,6 +80,12 @@
 #define TRANSFER_SINGLE_READ   0x12u   /* block count enable, read, single */
 #define TRANSFER_SINGLE_WRITE  0x02u   /* block count enable, write, single */
 
+/* Console log: 4 MiB ring plus one header sector at the start of p27. */
+#define PRA_LOG_SIZE           (4u << 20)
+#define PRA_LOG_SECTORS        (1u + PRA_LOG_SIZE / 512u)
+#define PRA_LOG_TAIL           3072u
+#define PRA_LOG_MAGIC          "PRALOG1"
+
 static vm_offset_t pra_emmc_regs;
 static uint64_t pra_emmc_first_lba, pra_emmc_nsectors;
 static char pra_emmc_partition_name[32] = "userdata";
