+static uint64_t _Atomic pra_log_total;
+static uint64_t pra_log_erecovery_lba, pra_log_erecovery_sectors;
+static bool pra_log_enabled;
+static bool pra_log_probed;
+static int pra_log_idle_limit;          /* 10 s ticks; 0 disables the check */
+static int pra_log_at_limit;            /* 10 s ticks; 0 disables the dump */
+static char pra_log_chan;
+static char pra_log_buf[PRA_LOG_TAIL + 1];
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
