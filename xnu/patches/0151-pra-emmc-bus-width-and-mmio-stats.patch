+/* Read the 512-byte EXT_CSD with CMD8. Nothing here writes; it only reports
+ * what LK left the card negotiated at (bus width, high-speed timing, device
+ * type), which is otherwise guesswork. */
+static int
+pra_emmc_read_extcsd(uint8_t *dst)
+{
+	struct pra_sdhci_saved s;
+	uint32_t status = 0;
+	int error = 0;
+
+	if (pra_emmc_wait_ready()) {
+		return EBUSY;
+	}
+	pra_emmc_save(&s);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_SIGNAL_EN, 0);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS_EN, 0x7ffu);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	pra_emmc_wr16(SDHCI_TIMEOUT_CONTROL, 0xeu);
+	pra_emmc_wr16(SDHCI_BLOCK_SIZE, 512);
+	pra_emmc_wr16(SDHCI_BLOCK_COUNT, 1);
+	pra_emmc_wr32(SDHCI_ARGUMENT, 0);
+	pra_emmc_wr16(SDHCI_TRANSFER_MODE, TRANSFER_SINGLE_READ);
+	__asm__ volatile("dsb sy" : : : "memory");
+	pra_emmc_wr16(SDHCI_COMMAND, CMD_R1_SEND_EXT_CSD);
+
+	for (unsigned i = 0; i < 2000000; i++) {
+		status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+		if (status & SDHCI_ERROR_BITS) {
+			error = EIO;
+			break;
+		}
+		if (status & NORMAL_CMD_COMPLETE) {
+			break;
+		}
+	}
+	if (!error && !(status & NORMAL_CMD_COMPLETE)) {
+		error = ETIMEDOUT;
+	}
+	if (!error && (pra_emmc_rd32(SDHCI_RESPONSE0) & 0xfdffe008u)) {
+		error = EIO;
+	}
+	if (!error) {
+		pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, NORMAL_CMD_COMPLETE);
+		error = ETIMEDOUT;
+		for (unsigned i = 0; i < 2000000; i++) {
+			status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+			if (status & SDHCI_ERROR_BITS) {
+				error = EIO;
+				break;
+			}
+			if (status & NORMAL_BUFFER_READ_READY) {
+				error = 0;
+				break;
+			}
+		}
+	}
+	if (!error) {
+		uint32_t data[128];
+		for (unsigned i = 0; i < 128; i++) {
+			data[i] = pra_emmc_rd32(SDHCI_BUFFER);
+		}
+		memcpy(dst, data, sizeof(data));
+	}
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	(void)pra_emmc_wait_ready();
+	pra_emmc_restore(&s);
+	return error;
+}
+
+/* CMD6 with no data phase: the response is all the answer we get. */
+static int
+pra_emmc_switch(uint32_t arg)
+{
+	struct pra_sdhci_saved s;
+	uint32_t status = 0;
+	int error = 0;
+
+	if (pra_emmc_wait_ready()) {
+		return EBUSY;
+	}
+	pra_emmc_save(&s);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_SIGNAL_EN, 0);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS_EN, 0x7ffu);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	pra_emmc_wr16(SDHCI_TIMEOUT_CONTROL, 0xeu);
+	pra_emmc_wr32(SDHCI_ARGUMENT, arg);
+	__asm__ volatile("dsb sy" : : : "memory");
+	pra_emmc_wr16(SDHCI_COMMAND, CMD_R1B_SWITCH);
+	for (unsigned i = 0; i < 2000000; i++) {
+		status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+		if (status & SDHCI_ERROR_BITS) {
+			error = EIO;
+			break;
+		}
+		if (status & NORMAL_CMD_COMPLETE) {
+			break;
+		}
+	}
+	if (!error && !(status & NORMAL_CMD_COMPLETE)) {
+		error = ETIMEDOUT;
+	}
+	if (!error && (pra_emmc_rd32(SDHCI_RESPONSE0) & 0xfdffe008u)) {
+		error = EIO;
+	}
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	(void)pra_emmc_wait_ready();
+	pra_emmc_restore(&s);
+	return error;
+}
+
+/* Report what the card and host are actually set to. */
+static void
+pra_emmc_report_csd(void)
+{
+	uint8_t ext[512];
+	uint32_t hc = pra_emmc_rd32(SDHCI_HOST_CONTROL);
+
+	printf("PRA eMMC: host_control=%x width=%s hs=%u\n", hc,
+	    (hc & HC_8BIT_WIDTH) ? "8bit" :
+	    (hc & HC_4BIT_WIDTH) ? "4bit" : "1bit",
+	    (hc & HC_HIGH_SPEED) ? 1 : 0);
+	if (pra_emmc_read_extcsd(ext)) {
+		printf("PRA eMMC: EXT_CSD read failed\n");
+		return;
+	}
+	printf("PRA eMMC: extcsd rev=%u bus_width=%u hs_timing=%u device_type=%x\n",
+	    ext[192], ext[183] & 0xfu, ext[185] & 0xfu, ext[196]);
+}
+
+/* Timing experiments, driven from the cmdline so a flashed image can be
+ * retried without a rebuild:
+ *   emmchsp=1    switch the card to high speed (EXT_CSD[185] HS_TIMING=1)
+ *   emmcdiv=<n>  write the 10-bit SDCLK divider and keep it only if sector 1
+ *                still reads back identically afterwards. */
+static void
+pra_emmc_tune(void)
+{
+	int hsp = 0, div = -1;
+	bool want_hsp = PE_parse_boot_argn("emmchsp", &hsp, sizeof(hsp)) && hsp != 0;
+	bool want_div = PE_parse_boot_argn("emmcdiv", &div, sizeof(div)) &&
+	    div >= 0 && div <= 1023;
+
+	if (!want_hsp && !want_div) {
+		return;
+	}
+	if (want_hsp) {
+		int error = pra_emmc_switch((3u << 24) | (185u << 16) | (1u << 8));
+		printf("PRA eMMC: HS_TIMING=1 %s (%d)\n",
+		    error ? "failed" : "ok", error);
+		if (!error) {
+			uint32_t hc = pra_emmc_rd32(SDHCI_HOST_CONTROL);
+			pra_emmc_wr32(SDHCI_HOST_CONTROL, hc | HC_HIGH_SPEED);
+		}
+	}
+	if (want_div) {
+		uint8_t before[512], after[512];
+		uint16_t old = pra_emmc_rd16(SDHCI_CLOCK_CONTROL);
+		uint16_t nv = (uint16_t)((old & 0x3fu) |
+		    (uint16_t)(((uint32_t)div & 0x3ffu) << 6));
+
+		if (pra_emmc_read_sector(1, before)) {
+			printf("PRA eMMC: emmcdiv=%d skipped, read failed\n", div);
+			return;
+		}
+		pra_emmc_wr16(SDHCI_CLOCK_CONTROL, nv);
+		for (unsigned i = 0; i < 100000; i++) {
+			__asm__ volatile("nop");
+		}
+		if (pra_emmc_read_sector(1, after) == 0 &&
+		    memcmp(before, after, sizeof(before)) == 0) {
+			printf("PRA eMMC: emmcdiv=%d kept clock=%x\n", div,
+			    pra_emmc_rd16(SDHCI_CLOCK_CONTROL));
+		} else {
+			pra_emmc_wr16(SDHCI_CLOCK_CONTROL, old);
+			printf("PRA eMMC: emmcdiv=%d rejected clock=%x\n", div,
+			    pra_emmc_rd16(SDHCI_CLOCK_CONTROL));
+		}
+	}
+}
