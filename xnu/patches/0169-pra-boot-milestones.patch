+/* Boot milestones (0006). mach_absolute_time ticks at 1.92 MHz - ADT
+ * timebase-frequency = 1920000 (docs/pra-address-overrides.md, confirmed in
+ * live dmesg; the same constant busy_note divides for its 10 s window) -
+ * and starts near kernel entry, so ticks / 1920000 is seconds since kernel
+ * start. One line per milestone; every call site is reached once per boot
+ * (map_host returns early on re-probe, the log start returns early once
+ * enabled), so no extra rate limiting. */
+static void
+pra_emmc_milestone(const char *what)
+{
+	printf("[+%3llu s] %s\n", mach_absolute_time() / 1920000ull, what);
+}
