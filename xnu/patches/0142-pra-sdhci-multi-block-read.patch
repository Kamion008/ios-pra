+/* Recover from a rejected multi-block transfer: reset the CMD and DAT lines so
+ * the next single-sector read starts from a clean command state. */
+static void
+pra_emmc_abort_data(void)
+{
+	pra_emmc_wr8(SDHCI_SOFTWARE_RESET, 0x6u);       /* CMD | DAT */
+	for (unsigned i = 0; i < 200000; i++) {
+		if (!(pra_emmc_rd8(SDHCI_SOFTWARE_RESET) & 0x6u)) {
+			break;
+		}
+	}
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	pra_emmc_ensure_clock();
+}
+
+/* One CMD18 for up to PRA_MULTI_MAX sectors. The block count register drives
+ * how much the card sends; auto CMD12 stops the transfer, so there is no
+ * separate STOP command. The port still has to be drained one 512-byte block
+ * at a time, but the command/response overhead is paid once per chunk. */
+static int
+pra_emmc_read_multi(uint32_t lba, uint8_t *dst, uint32_t nblocks)
+{
+	struct pra_sdhci_saved s;
+	uint32_t status = 0;
+	int error = 0;
+
+	if (pra_emmc_wait_ready()) {
+		printf("PRA eMMC: card busy, skip read lba=%u\n", lba);
+		return EBUSY;
+	}
+
+	pra_emmc_save(&s);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_SIGNAL_EN, 0);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS_EN, 0x7ffu);
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	pra_emmc_wr16(SDHCI_TIMEOUT_CONTROL, 0xeu);
+	pra_emmc_wr16(SDHCI_BLOCK_SIZE, 512);
+	pra_emmc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)nblocks);
+	pra_emmc_wr32(SDHCI_ARGUMENT, lba);
+	pra_emmc_wr16(SDHCI_TRANSFER_MODE, TRANSFER_MULTI_READ);
+	__asm__ volatile("dsb sy" : : : "memory");
+	pra_emmc_wr16(SDHCI_COMMAND, CMD_R1_MULTI_READ);
+
+	for (unsigned i = 0; i < 2000000; i++) {
+		status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+		if (status & SDHCI_ERROR_BITS) {
+			error = EIO;
+			break;
+		}
+		if (status & NORMAL_CMD_COMPLETE) {
+			break;
+		}
+	}
+	if (error) {
+		printf("PRA eMMC: CMD18 lba=%u command error status=%x\n", lba, status);
+		goto out;
+	}
+	if (!(status & NORMAL_CMD_COMPLETE)) {
+		printf("PRA eMMC: CMD18 lba=%u command timeout status=%x\n", lba, status);
+		error = ETIMEDOUT;
+		goto out;
+	}
+	if (pra_emmc_rd32(SDHCI_RESPONSE0) & 0xfdffe008u) {
+		printf("PRA eMMC: CMD18 lba=%u card error r1=%x\n",
+		    lba, pra_emmc_rd32(SDHCI_RESPONSE0));
+		error = EIO;
+		goto out;
+	}
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, NORMAL_CMD_COMPLETE);
+
+	for (uint32_t b = 0; b < nblocks; b++) {
+		uint32_t data[128];
+
+		error = ETIMEDOUT;
+		for (unsigned i = 0; i < 2000000; i++) {
+			status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+			if (status & SDHCI_ERROR_BITS) {
+				error = EIO;
+				break;
+			}
+			if (status & NORMAL_BUFFER_READ_READY) {
+				error = 0;
+				break;
+			}
+		}
+		if (error) {
+			printf("PRA eMMC: CMD18 lba=%u block %u status=%x\n",
+			    lba, b, status);
+			goto out;
+		}
+		for (unsigned i = 0; i < 128; i++) {
+			data[i] = pra_emmc_rd32(SDHCI_BUFFER);
+		}
+		memcpy(dst + (uint64_t)b * 512u, data, sizeof(data));
+	}
+
+	error = ETIMEDOUT;
+	for (unsigned i = 0; i < 2000000; i++) {
+		status = pra_emmc_rd32(SDHCI_NORMAL_INT_STATUS);
+		if (status & SDHCI_ERROR_BITS) {
+			error = EIO;
+			break;
+		}
+		if (status & NORMAL_TRANSFER_COMPLETE) {
+			error = 0;
+			break;
+		}
+	}
+	if (error) {
+		printf("PRA eMMC: CMD18 lba=%u transfer status=%x\n", lba, status);
+		goto out;
+	}
+
+out:
+	pra_emmc_wr32(SDHCI_NORMAL_INT_STATUS, 0xffffffffu);
+	if (error) {
+		pra_emmc_abort_data();
+	} else {
+		(void)pra_emmc_wait_ready();
+	}
+	pra_emmc_restore(&s);
+	return error;
+}
+
+/* emmcstats=1 reports the achieved rate, so the gain over per-sector reads is
+ * measured on the phone instead of guessed. */
+static void
+pra_emmc_note_io(uint32_t bytes, uint32_t cmds, uint64_t start)
+{
+	uint64_t delta, ns;
+
+	if (!pra_emmc_stats || bytes == 0) {
+		return;
+	}
+	delta = mach_absolute_time() - start;
+	absolutetime_to_nanoseconds(delta, &ns);
+	pra_emmc_stat_bytes += bytes;
+	pra_emmc_stat_cmds += cmds;
+	pra_emmc_stat_ns += ns;
+	if (pra_emmc_stat_bytes >= (8u << 20)) {
+		uint64_t kib = pra_emmc_stat_bytes >> 10;
+		uint64_t kbs = pra_emmc_stat_ns ?
+		    (pra_emmc_stat_bytes * 1000000000ull) / pra_emmc_stat_ns / 1024ull : 0;
+		printf("PRA eMMC: %llu KiB, %llu cmds, %llu KiB/s\n",
+		    kib, pra_emmc_stat_cmds, kbs);
+		pra_emmc_stat_bytes = 0;
+		pra_emmc_stat_cmds = 0;
+		pra_emmc_stat_ns = 0;
+	}
+}
